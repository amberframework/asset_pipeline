--- Generated material CSS custom properties ---
  --ap-material-intensity: 1.3;
  --ap-material-blur-ultra-thin: calc(10px * var(--ap-material-intensity, 1));
  --ap-material-opacity-ultra-thin: 0.2;
  --ap-material-saturation-ultra-thin: 1.05;
  --ap-material-blur-thin: calc(20px * var(--ap-material-intensity, 1));
  --ap-material-opacity-thin: 0.4;
  --ap-material-saturation-thin: 1.1;
  --ap-material-blur-regular: calc(30px * var(--ap-material-intensity, 1));
  --ap-material-opacity-regular: 0.6;
  --ap-material-saturation-regular: 1.15;
  --ap-material-blur-thick: calc(40px * var(--ap-material-intensity, 1));
  --ap-material-opacity-thick: 0.73;
  --ap-material-saturation-thick: 1.2;
  --ap-material-blur-chrome: calc(50px * var(--ap-material-intensity, 1));
  --ap-material-opacity-chrome: 0.87;
  --ap-material-saturation-chrome: 1.25;
  .ap-glass--ultra-thin { background: color-mix(in oklch, var(--ap-color-surface-panel) calc(var(--ap-material-opacity-ultra-thin) * 100%), transparent); }
  .ap-glass--thin { background: color-mix(in oklch, var(--ap-color-surface-panel) calc(var(--ap-material-opacity-thin) * 100%), transparent); }
  .ap-glass--regular { background: color-mix(in oklch, var(--ap-color-surface-panel) calc(var(--ap-material-opacity-regular) * 100%), transparent); }
  .ap-glass--thick { background: color-mix(in oklch, var(--ap-color-surface-panel) calc(var(--ap-material-opacity-thick) * 100%), transparent); }
  .ap-glass--chrome { background: color-mix(in oklch, var(--ap-color-surface-panel) calc(var(--ap-material-opacity-chrome) * 100%), transparent); }

