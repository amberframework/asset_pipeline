      def apple_step(declared : Symbol) : Symbol
        return declared unless declared == :regular
        i = intensity
        return :ultra_thin if i <= 0.3
        return :thin if i <= 0.7
        return :regular if i <= 1.3
        return :chrome if i >= 1.8
        :thick
      end

